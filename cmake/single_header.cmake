# Generates the single header venus.hpp from the separate venus headers, by inlining every
# '#include "executor/..."' (depth first, every header once).
#
#   cmake -DINCLUDE_DIR=<dir with executor/> -DOUTPUT=<venus.hpp> -P single_header.cmake

cmake_minimum_required(VERSION 3.18) # script mode: enables the policies of this version, like IN_LIST

if (NOT INCLUDE_DIR OR NOT OUTPUT)
  message(FATAL_ERROR "usage: cmake -DINCLUDE_DIR=<dir> -DOUTPUT=<file> -P single_header.cmake")
endif()

set_property(GLOBAL PROPERTY venus_inlined_headers "")

# replaces every '#include "executor/..."' in 'content' by the (expanded) header, or removes it when already inlined
function(venus_expand_includes content out_var)
  string(REGEX MATCHALL "#include \"executor/[^\"]+\"" includes "${content}")
  foreach (include IN LISTS includes)
    string(REGEX REPLACE "#include \"(executor/[^\"]+)\"" "\\1" header "${include}")
    get_property(inlined GLOBAL PROPERTY venus_inlined_headers)
    if (header IN_LIST inlined)
      set(expanded "")
    else()
      set_property(GLOBAL APPEND PROPERTY venus_inlined_headers "${header}")
      file(READ "${INCLUDE_DIR}/${header}" expanded)
      string(REPLACE "\r\n" "\n" expanded "${expanded}")
      string(REPLACE "#pragma once\n" "" expanded "${expanded}")
      venus_expand_includes("${expanded}" expanded)
      set(expanded "// begin ${header}\n${expanded}// end ${header}\n")
    endif()
    string(REPLACE "${include}\n" "${expanded}" content "${content}")
  endforeach()
  set(${out_var} "${content}" PARENT_SCOPE)
endfunction()

# every header, sorted, so the single header never misses one; dependencies are inlined where they are first included
file(GLOB_RECURSE headers RELATIVE "${INCLUDE_DIR}" "${INCLUDE_DIR}/executor/*.hpp")
list(SORT headers)
set(root "")
foreach (header IN LISTS headers)
  string(APPEND root "#include \"${header}\"\n")
endforeach()

venus_expand_includes("${root}" body)

set(result "/*
 * venus: https://github.com/janwilmans/venus
 * Copyright (c) 2025 Jan Wilmans
 *
 * Single header version of venus, generated by the build (cmake/single_header.cmake) from the headers in
 * src/executor/include/executor/, do not edit.
 */

#pragma once

${body}")

# only write when changed, so an unchanged header does not trigger rebuilds or show up as modified
if (EXISTS "${OUTPUT}")
  file(READ "${OUTPUT}" current)
  if (current STREQUAL result)
    return()
  endif()
endif()
# LF on every platform (file(WRITE) writes CRLF on Windows), the content is inserted as one @result@ value,
# so nothing inside the C++ code is substituted
file(CONFIGURE OUTPUT "${OUTPUT}" CONTENT "@result@" @ONLY NEWLINE_STYLE UNIX)
message(STATUS "Generated ${OUTPUT}")
